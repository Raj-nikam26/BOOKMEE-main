# ---------- Required (already set up for local use) ----------
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookme
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Admin panel login (http://localhost:5173/admin/login)
ADMIN_EMAIL=admin@bookme.local
ADMIN_PASSWORD=change-me

# ---------- Optional: Stripe payments ----------
# Get a TEST key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=
# While STRIPE_SECRET_KEY is empty, paid bookings are confirmed without a real checkout.
DEMO_PAYMENTS=true

# ---------- Optional: Brevo emails (OTP + booking emails) ----------
# Get a key from https://app.brevo.com -> Settings -> SMTP & API -> API Keys
# BREVO_SENDER_EMAIL must be a sender you verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BookMe

# ---------- Optional: Google Calendar sync ----------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ---------- Sample data (npm run seed) ----------
# Password of every sample business and sample customer account.
SEED_PASSWORD=change-me

# ---------- Razorpay payments (preferred in India) ----------
# Test keys from https://dashboard.razorpay.com -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
